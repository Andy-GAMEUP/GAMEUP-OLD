    <select id="selectTerms" resultMap="resultTbTerms">
    <![CDATA[
        SELECT *
        FROM TB_TERMS
        ORDER BY TT_SEQ
        ]]>
    </select>

    <select id="selectTermsById" resultMap="resultTbTerms">
    <![CDATA[
        SELECT *
        FROM TB_TERMS
        WHERE TT_ID = #{termsId, jdbcType=INTEGER}
        ORDER BY TT_SEQ
        ]]>
    </select>

    <update id="updateTerms">
        UPDATE TB_TERMS
        SET TT_CONTENT = #{paramVO.content, jdbcType=VARCHAR}
        WHERE TT_ID = #{paramVO.id, jdbcType=INTEGER}
    </update>

</mapper>