    <resultMap id="resultTbTerms" type="com.capcloud.gameup.api.domain.database.TB_TERMS">
        <id column="TT_ID" property="termsId" javaType="java.lang.Integer" jdbcType="INTEGER"/>
        <id column="TT_SEQ" property="termsSeq" javaType="java.lang.Integer" jdbcType="INTEGER"/>
        <id column="TT_VERSION" property="termsVersion" javaType="java.lang.String" jdbcType="VARCHAR"/>
        <id column="TT_IS_REQUIRED" property="termsIsRequired" javaType="java.lang.Integer" jdbcType="INTEGER"/>
        <id column="TT_TITLE" property="termsTitle" javaType="java.lang.String" jdbcType="VARCHAR"/>
        <id column="TT_CONTENT" property="termsContent" javaType="java.lang.String" jdbcType="VARCHAR"/>
        <id column="TT_CREATED_DATE" property="termsCreatedDate" javaType="java.lang.String" jdbcType="VARCHAR"/>
    </resultMap>

